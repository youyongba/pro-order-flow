# Independent project; no credentials or proxy addresses are bundled.
# Copy to .env for local settings. This example is NOT ignored by Git.
HOST=127.0.0.1
PORT=3104
# Binance public spot REST timeout; no API key is required.
BINANCE_TIMEOUT_MS=10000
CONFIG_AUTH_TOKEN=
# Optional Feishu custom bot. Keep disabled until new credentials are configured.
# Use plain URLs without Markdown backticks.
FEISHU_WEBHOOK_URL=
FEISHU_WEBHOOK_SECRET=
WEBHOOK_ENABLED=0
WEBHOOK_MIN_INTERVAL_MS=30000
WEBHOOK_EVENT_COOLDOWN_MS=300000
ORDERFLOW_DELTA_ALERT_MIN=50

# Configure network proxies in the launching shell only, never in this file.
